      "title": "Queue Backlog (BullMQ Depth)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "whiteboard_queue_length",
          "legendFormat": "{{queue}} - {{state}}",
          "refId": "A"
