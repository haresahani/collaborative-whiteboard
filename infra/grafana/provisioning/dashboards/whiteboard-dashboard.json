        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(whiteboard_compaction_latency_seconds_bucket[1m])) by (le, branch))",
          "legendFormat": "p95 compaction ({{branch}})",
          "refId": "B"
        }
