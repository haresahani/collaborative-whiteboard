{
  "private": true,
  "name": "collaborative-whiteboard",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tests/e2e/playwright",
    "tests/performance/k6"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "predev": "pnpm --filter shared build",
    "dev": "pnpm -r --parallel --filter ./packages/* --if-present dev",
    "prestart:dev": "pnpm --filter shared build",
    "start:dev": "pnpm -r --parallel --filter ./packages/* --if-present start:dev",
    "build": "pnpm --parallel --filter ./packages/* build",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "pnpm -r --filter ./packages/* --if-present lint",
    "format": "prettier --write .",
    "prepare": "husky install || true",
    "test": "pnpm --filter \"./packages/*\" --workspace-concurrency 1 test",
    "test:e2e": "playwright test --project=chromium --config=tests/e2e/playwright/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=tests/e2e/playwright/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config=tests/e2e/playwright/playwright.config.ts",
    "test:e2e:debug": "playwright test --debug --config=tests/e2e/playwright/playwright.config.ts",
    "test:e2e:report": "playwright show-report tests/e2e/playwright/reports/html",
    "performance:smoke": "k6 run tests/performance/k6/scenarios/smoke.ts",
    "performance:load": "k6 run tests/performance/k6/scenarios/load.ts",
    "performance:stress": "k6 run tests/performance/k6/scenarios/stress.ts",
    "performance:spike": "k6 run tests/performance/k6/scenarios/spike.ts",
    "performance:soak": "k6 run tests/performance/k6/scenarios/soak.ts",
    "performance:breakpoint": "k6 run tests/performance/k6/scenarios/breakpoint.ts",
    "load-test:sockets": "tsx scripts/load-test-sockets.ts",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:chaos:up": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.chaos.yml up -d",
    "test:chaos": "vitest run tests/chaos/specs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^6.0.3",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^4.0.8",
    "dotenv": "^17.2.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.0.10",
    "husky": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "react-window": "^2.2.3",
    "socket.io": "^4.8.1",
    "tailwind-merge": "^3.3.1"
  }
}
