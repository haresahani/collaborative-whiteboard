{
  "name": "shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jwt": {
      "types": "./src/jwt.ts",
      "import": "./dist/jwt.js",
      "default": "./dist/jwt.js"
    },
    "./models": {
