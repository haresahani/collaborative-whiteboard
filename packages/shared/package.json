      "default": "./dist/models/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "jsonwebtoken": "^9.0.3",
